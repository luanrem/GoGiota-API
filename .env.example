# Copie para .env e preencha com os valores reais:
#   cp .env.example .env
#
# Os nomes abaixo sao lidos por:
#   - compose.yaml                                (sobe o Postgres)
#   - internal/store/pgstore/migrations/tern.conf (roda as migrations)
#   - cmd/api                                     (conecta na API)

GOGIOTA_DATABASE_USER=""
GOGIOTA_DATABASE_PASSWORD=""
GOGIOTA_DATABASE_NAME=""
GOGIOTA_DATABASE_HOST="localhost"
GOGIOTA_DATABASE_PORT="5432"

# Chave usada para assinar os tokens CSRF.
# Gere uma com: openssl rand -base64 32
GOGIOTA_CSRF_KEY=""
